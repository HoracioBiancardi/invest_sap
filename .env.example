# Credenciais do invest_sap — copie para .env (que é ignorado pelo git) e preencha.
# Nunca commitar valores reais.
#
# Recomendado: depois do 1º acesso, mova HANA_*/DDIC_SCHEMA/SQLSERVER_* para o cofre cifrado
# (Admin → Cofre, ver docs/COMO_RODAR.md §2.1) e apague-as daqui — com o cofre criado, o app
# ignora estas variáveis.

# SAP HANA / Datasphere
HANA_ADDRESS=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
DDIC_SCHEMA=IB_SAPECC
DDIC_LANGUAGE=

# SQL Server (BRONZE/SILVER/GOLD)
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Portal de acesso (web/auth.py). Usuários ficam em data/app.db (SQLite local).
# Na 1ª execução, cria o admin "admin": com esta senha (mín. 10 caracteres e força Média —
# ver scripts/password_service.py) ou, se vazia/fraca, com uma senha aleatória em .access_key
# (0600) e troca obrigatória no 1º login.
APP_ACCESS_KEY=
# Opcional: caminho do banco local (default data/app.db).
APP_DB_PATH=

# App web (python -m web). Padrões seguros: loopback, cookie Secure.
# APP_HOST=127.0.0.1           # no Docker o Dockerfile já usa 0.0.0.0
# APP_PORT=8000                # no Docker: 8005 (a 8004 é do input_arquivos na mesma VM)
# APP_FORWARDED_IPS=127.0.0.1  # IP do proxy reverso HTTPS
# APP_ACCESS_KEY_FILE=         # onde gravar a senha do admin inicial (Docker: /app/data/.access_key)
#
# Cookie de sessão só por HTTPS (padrão 1). Com acesso HTTP direto pelo IP da VM (sem Caddy,
# como o input_arquivos hoje), o navegador descarta cookie Secure e o login não fica: use 0
# até ligar o HTTPS, e volte para 1 depois.
APP_COOKIE_SECURE=1
