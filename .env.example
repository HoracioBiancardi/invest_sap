# Credenciais do invest_sap — copie para .env (que é ignorado pelo git) e preencha.
# Nunca commitar valores reais.

# SAP HANA / Datasphere
HANA_ADDRESS=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
DDIC_SCHEMA=IB_SAPECC
DDIC_LANGUAGE=

# SQL Server (BRONZE/SILVER/GOLD)
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Portal de acesso (scripts/auth.py). Usuários ficam em data/app.db (SQLite local).
# Na 1ª execução, cria o admin "admin": com esta senha (mín. 10 caracteres) ou, se vazia,
# com uma senha aleatória em .access_key (0600) e troca obrigatória no 1º login.
APP_ACCESS_KEY=
# Opcional: caminho do banco local (default data/app.db).
APP_DB_PATH=
